# Copia questo file in env.properties, nella cartella da cui lanci il server (di solito la radice del repository), e compila
# i valori (env.properties è ignorato da git). Tutte le variabili e i loro valori di base: README, «Variabili di configurazione»
DB_USERNAME=postgres
DB_PASSWORD=la-tua-password-postgres
# Facoltative: host, porta e nome del database (default localhost, 5432, hoop3x3)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hoop3x3

# Facoltativa: porta del server (default 3001; su Render la assegna Render)
# PORT=3001

# Obbligatorio: firma i JWT. Almeno 32 caratteri casuali, altrimenti il server non parte. Generane uno con:
#   openssl rand -base64 48
# Cambiarlo invalida i token già emessi: gli utenti rifanno il login
JWT_SECRET=

# Facoltativa: chi risponde al Coach AI, groq (di base) oppure anthropic (con ANTHROPIC_API_KEY e ANTHROPIC_MODEL, più sotto)
# COACH_FORNITORE=anthropic
# Chiave Groq per il Coach AI (gratuita su console.groq.com). Vuota = Coach disattivato, se il fornitore è groq
GROQ_API_KEY=
# Facoltativa: modello Groq del Coach AI (default openai/gpt-oss-120b, che supporta il tool calling)
# GROQ_MODEL=openai/gpt-oss-120b
# Facoltativa: quanto il modello ragiona prima di rispondere (default low). Vuota con un modello che non accetta il campo
# GROQ_REASONING_EFFORT=low

# Facoltative: lettura delle foto dei fogli di tappa (README, «Lettura dei fogli (foto)»). Il fornitore: groq oppure anthropic
# (vuota = lettura spenta). Con groq serve GROQ_API_KEY qui sopra, con anthropic ANTHROPIC_API_KEY
# AI_LETTORE_FOGLIO=groq
# Il modello con immagini di Groq (default qwen/qwen3.8-27b)
# GROQ_MODELLO_VISIONE=qwen/qwen3.8-27b
# La chiave Anthropic (un segreto: su Render tra le variabili del servizio backend) e il modello (default claude-haiku-5-5).
# Servono sia al Coach con COACH_FORNITORE=anthropic sia alla lettura dei fogli con AI_LETTORE_FOGLIO=anthropic: la stessa chiave
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Recupero password: la chiave dell'API di Brevo, che manda il link, e il mittente (l'indirizzo Gmail verificato in Brevo).
# Vuote = le email non partono, un WARN all'avvio lo dice e l'endpoint risponde lo stesso. Su Render si impostano a mano tra
# le variabili del servizio backend (la chiave è un segreto)
BREVO_API_KEY=
MAIL_USERNAME=
# Facoltativa: indirizzo pubblico del frontend, per il link dell'email (default http://localhost:5173; su Render
# https://hoop3x3.onrender.com)
# APP_FRONTEND_URL=http://localhost:5173

# Utente ADMIN creato al primo avvio. La password deve avere almeno 8 caratteri ed essere diversa da admin123:
# altrimenti (anche se resta vuota, come qui) l'admin non viene creato e nei log compare un avviso.
# Con l'email vuota il seeder è spento (una riga INFO nei log lo dice); con la password impostata e l'email vuota
# compare un avviso, perché di solito è l'email dimenticata
ADMIN_EMAIL=admin@hoop3x3.it
ADMIN_PASSWORD=

# true = al primo avvio carica i dati di prova (resources/seed/estathe25.json) sul database, una volta sola (vedi README,
# «Dati di prova»)
SEED_DEMO=false
# true = al primo avvio carica solo i campetti di esempio (Torino e Roma), senza il circuito Estathé né la lega demo. Con SEED_DEMO=true
# i campetti ci sono comunque
SEED_CAMPETTI=false

# Di base è true (produzione con HTTPS: il cookie di refresh viaggia solo su connessioni cifrate) e in produzione non va
# toccata. Solo in sviluppo su http://localhost si toglie il commento e si mette a false, altrimenti un browser che non
# tratta localhost come sicuro scarta il cookie
# AUTH_COOKIE_SECURE=false

# Origini del frontend ammesse dal CORS, separate da virgola. In produzione: l'origine pubblica del frontend
# (senza questa riga valgono quelle di sviluppo: localhost:5173, 127.0.0.1:5173, localhost:4173)
# CORS_ORIGINS=https://app.esempio.it

# Altre impostazioni hanno già un valore di base in application.properties e non sono qui: durata del JWT (jwt.durata-minuti),
# giorni del refresh token (auth.refresh-giorni), limiti di frequenza (limite.*). Per cambiarle, in questo file si scrive il nome
# della proprietà (per esempio limite.auth-al-minuto=60): il nome in maiuscolo (LIMITE_AUTH_AL_MINUTO) qui dentro non ha effetto,
# vale solo come variabile d'ambiente del sistema. Il README ha l'elenco completo
